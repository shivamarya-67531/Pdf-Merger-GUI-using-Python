import tkinter as tk
from pathlib import Path
from tkinter import filedialog, messagebox, ttk

from pypdf import PdfWriter


def merge_pdfs(pdf_files, output_file):
    """Merge the selected PDF files into one output file."""
    merger = PdfWriter()
    try:
        for pdf_file in pdf_files:
            merger.append(pdf_file)
        merger.write(output_file)
    finally:
        merger.close()


class PdfMergerApp:
    def __init__(self, root):
        self.root = root
        self.root.title("PDF Merger")
        self.root.resizable(True, True)
        self.pdf_files = []

        frame = ttk.Frame(root, padding=16)
        frame.grid(sticky="nsew")

        ttk.Label(frame, text="Select PDF files to merge").grid(
            row=0, column=0, columnspan=2, sticky="w", pady=(0, 8)
        )

        self.file_list = tk.Listbox(frame, width=110, height=20, selectmode=tk.EXTENDED)
        self.file_list.grid(row=1, column=0, columnspan=2, pady=(0, 8))

        ttk.Button(frame, text="Add PDFs", command=self.add_files).grid(
            row=2, column=0, sticky="w"
        )
        ttk.Button(frame, text="Remove Selected", command=self.remove_selected).grid(
            row=2, column=1, sticky="e"
        )
        ttk.Button(frame, text="Move Up", command=self.move_up).grid(
            row=3, column=0, sticky="w"
        )
        ttk.Button(frame, text="Move Down", command=self.move_down).grid(
            row=3, column=1, sticky="e"
        )

        ttk.Label(frame, text="Output file").grid(
            row=4, column=0, sticky="w", pady=(16, 4)
        )
        self.output_entry = ttk.Entry(frame, width=48)
        self.output_entry.insert(0, "merged_output.pdf")
        self.output_entry.grid(row=4, column=0, sticky="ew")
        ttk.Button(frame, text="Browse", command=self.choose_output).grid(
            row=4, column=1, padx=(8, 0)
        )

        ttk.Button(frame, text="Merge PDFs", command=self.merge).grid(
            row=5, column=0, columnspan=2, pady=(16, 0)
        )

    def add_files(self):
        selected_files = filedialog.askopenfilenames(
            title="Select PDF files",
            filetypes=[("PDF files", "*.pdf"), ("All files", "*.*")],
        )
        for file_path in selected_files:
            if file_path not in self.pdf_files:
                self.pdf_files.append(file_path)
                self.file_list.insert(tk.END, file_path) 

    def remove_selected(self):
        selected_indexes = list(self.file_list.curselection())
        for index in reversed(selected_indexes):
            self.file_list.delete(index)
            self.pdf_files.pop(index)

    def choose_output(self):
        output_file = filedialog.asksaveasfilename(
            title="Save merged PDF",
            defaultextension=".pdf",
            filetypes=[("PDF files", "*.pdf")],
            initialfile="merged_output.pdf",
        )
        if output_file:
            self.output_entry.delete(0, tk.END)
            self.output_entry.insert(0, output_file)

    def merge(self):
        output_file = self.output_entry.get().strip()
        if len(self.pdf_files) < 2:
            messagebox.showwarning("Missing PDFs", "Please select at least two PDF files.")
            return
        if not output_file:
            messagebox.showwarning("Missing output", "Please choose an output file.")
            return

        try:
            merge_pdfs(self.pdf_files, Path(output_file))
        except Exception as error:
            messagebox.showerror("Merge failed", str(error))
        else:
            messagebox.showinfo("Success", f"Merged PDF saved to:\n{output_file}")

    # move selected file up in the list
    def move_up(self):
        selected_indexes = list(self.file_list.curselection())
        if not selected_indexes:
            return
        for index in selected_indexes:
            if index > 0:
                self.pdf_files[index], self.pdf_files[index - 1] = (
                    self.pdf_files[index - 1],
                    self.pdf_files[index],
                )
                self.file_list.delete(index)
                self.file_list.insert(index - 1, self.pdf_files[index - 1])
                self.file_list.selection_set(index - 1)

    # move selected file down in the list
    def move_down(self):
        selected_indexes = list(self.file_list.curselection())
        if not selected_indexes:
            return
        for index in reversed(selected_indexes):
            if index < len(self.pdf_files) - 1:
                self.pdf_files[index], self.pdf_files[index + 1] = (
                    self.pdf_files[index + 1],
                    self.pdf_files[index],
                )
                self.file_list.delete(index)
                self.file_list.insert(index + 1, self.pdf_files[index + 1])
                self.file_list.selection_set(index + 1)


if __name__ == "__main__":
    root = tk.Tk()
    PdfMergerApp(root)
    root.mainloop()
